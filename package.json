{
  "name": "enhancer-vhsrip",
  "version": "0.1.0",
  "scripts": {
    "setup": "node scripts/setup-tools.mjs",
    "dev": "concurrently -k -n ng,tsc,app -c yellow,blue,green \"ng serve --port 4300\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on tcp:4300 dist-electron/electron/main.js && cross-env ENHANCER_DEV_URL=http://localhost:4300 electron .\"",
    "build": "ng build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "extract-zip": "^2.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  },
  "description": "Локальная программа для улучшения VHSRip-видео: деинтерлейс, шумоподавление, цвет, нейросетевой апскейл Real-ESRGAN.",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.povezlo2.enhancer-vhsrip",
    "productName": "Enhancer VHSRip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
